{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // Tests may see Vitest's types; src still compiles with types: [] under
    // tsconfig.json, which is what keeps Node and DOM globals out of the core.
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/fixtures"]
}
